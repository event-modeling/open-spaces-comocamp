<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Conference IDs to Generate</title>
    <link rel="stylesheet" href="/styles/main.css">
</head>
<body>

    <main class="container">
        <h1>Conference IDs to Generate</h1>
        
        <section class="form-section">
            <form action="/provide-conference-id" method="POST" class="manual-id-form" enctype="multipart/form-data">
                <div class="form-group">
                    <label for="conference_id">Conference ID:</label>
                    <input type="text" id="conference_id" name="conference_id" required {{^query.requested}}disabled{{/query.requested}}>
                    <button type="submit" class="btn" {{^query.requested}}disabled{{/query.requested}}>Add ID manually</button>
                </div>
            </form>

            <div class="results-section">
                <h3>Currently waiting for confID:</h3>
                {{#query.requested}}
                    <p>Yes</p>
                {{/query.requested}}
                {{^query.requested}}
                    <p>No</p>
                {{/query.requested}}
            </div>
        </section>
    </main>
</body>
</html> 